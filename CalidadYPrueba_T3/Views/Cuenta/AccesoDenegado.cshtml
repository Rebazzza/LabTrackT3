@{
    ViewData["Title"] = "Acceso denegado";
}
<section class="content-panel narrow-panel">
    <p class="eyebrow">PERMISOS DE ACCESO</p>
    <h1>Acceso denegado</h1>
    <p>Tu cuenta no tiene permisos para acceder a esta sección. Si necesitas otro perfil, comunícate con el encargado del laboratorio.</p>
    @if (User.IsInRole("Estudiante") || User.IsInRole("Encargado"))
    {
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver a mi panel</a>
    }
    else if (User.Identity?.IsAuthenticated != true)
    {
        <a class="btn btn-primary" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
    }
</section>
