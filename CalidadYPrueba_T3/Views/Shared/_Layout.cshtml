<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · LabTrack</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
        <nav class="container app-nav" aria-label="Navegación principal">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-symbol" aria-hidden="true">Lt</span><span>LabTrack<small>Equipos de laboratorio</small></span></a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="session-nav">
                    <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() is "Estudiante" or "Encargado" ? "is-current" : null)" asp-controller="Home" asp-action="Index">Mi panel</a>
                    @if (User.IsInRole("Estudiante") || User.IsInRole("Encargado"))
                    {
                        <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Catalogo" ? "is-current" : null)" asp-controller="Catalogo" asp-action="Index">Catálogo</a>
                    }
                    <span class="session-code">@User.Identity.Name</span>
                    @if (User.IsInRole("Encargado"))
                    {
                        <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Solicitudes" ? "is-current" : null)" asp-controller="Solicitudes" asp-action="Index">Solicitudes</a>
                        <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Devoluciones" ? "is-current" : null)" asp-controller="Devoluciones" asp-action="Index">Devoluciones</a>
                    }
                    @if (User.IsInRole("Estudiante"))
                    {
                        <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservas" ? "is-current" : null)" asp-controller="Reservas" asp-action="Index">Mis reservas</a>
                    }
                    <form asp-controller="Cuenta" asp-action="Salir" method="post">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Cerrar sesión</button>
                    </form>
                </div>
            }
            else
            {
                <span class="header-caption">Gestión de equipos de laboratorio</span>
            }
        </nav>
    </header>
    <main id="contenido" class="container app-main" tabindex="-1">@RenderBody()</main>
    <footer class="site-footer"><div class="container">LabTrack · Gestión de equipos de laboratorio</div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
